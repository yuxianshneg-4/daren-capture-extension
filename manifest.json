{
  "manifest_version": 3,
  "name": "达人信息抓取录入助手",
  "version": "1.3.9",
  "description": "在抖音精选联盟达人详情页自动识别达人数据，一键录入飞书多维表格",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.jinritemai.com/*",
    "https://open.feishu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.jinritemai.com/*"],
      "js": ["patch_open.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.jinritemai.com/*"],
      "js": ["scrapers.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
